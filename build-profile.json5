{
  "app": {
    // 签名配置（signingConfigs）刻意不纳入公开仓库：其中包含本机绝对路径与签名口令。
    // 首次构建前请在 DevEco Studio 中生成自己的签名：
    //   File → Project Structure → Signing Configs → 勾选 "Automatically generate signature"
    //   （需登录华为开发者账号），IDE 会自动在下方补回 signingConfigs 与 products 的 signingConfig 字段。
    // 详见 README.md「构建与运行」。
    "products": [
      {
        "name": "default",
        "targetSdkVersion": "6.1.1(24)",
        "compatibleSdkVersion": "6.1.0(23)",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug",
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default"
          ]
        }
      ]
    }
  ]
}